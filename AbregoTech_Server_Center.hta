<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>AbregoTech LISCORE — Centro de Control Enterprise</title>
  <hta:application
    id="AbregoTechServerCenter"
    applicationname="AbregoTech Server Center"
    border="thin"
    borderstyle="normal"
    caption="yes"
    icon=""
    maximizebutton="yes"
    minimizebutton="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
    scroll="yes"
  />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    body {
      background: #020617;
      color: #f8fafc;
      padding: 24px;
      font-size: 14px;
      line-height: 1.5;
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
    }
    /* Banner superior */
    .top-header {
      border-bottom: 2px solid #0e7490;
      padding-bottom: 18px;
      margin-bottom: 20px;
    }
    .brand-title {
      font-size: 26px;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -0.5px;
    }
    .brand-cyan {
      color: #22d3ee;
    }
    .brand-sub {
      font-size: 13px;
      color: #94a3b8;
      margin-top: 4px;
    }
    .launch-hero-btn {
      display: block;
      width: 100%;
      background: #0891b2;
      color: #ffffff;
      font-size: 16px;
      font-weight: 800;
      text-align: center;
      padding: 16px;
      border-radius: 14px;
      border: 2px solid #22d3ee;
      cursor: pointer;
      margin-bottom: 24px;
      text-decoration: none;
    }
    .launch-hero-btn:hover {
      background: #06b6d4;
    }
    /* Tabla de 2 columnas para compatibilidad perfecta en HTA */
    .grid-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 16px;
      margin-bottom: 20px;
    }
    .card-cell {
      width: 50%;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 20px;
      vertical-align: top;
    }
    .card-title {
      font-size: 17px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 6px;
    }
    .card-port {
      display: inline-block;
      background: #164e63;
      color: #67e8f9;
      font-family: Consolas, monospace;
      font-size: 12px;
      font-weight: bold;
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 10px;
    }
    .card-desc {
      font-size: 13px;
      color: #cbd5e1;
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .card-stats {
      font-family: Consolas, monospace;
      font-size: 12px;
      color: #38bdf8;
      background: #020617;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #1e293b;
    }
    /* Controles y Accesos */
    .section-title {
      font-size: 15px;
      font-weight: 800;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 20px 0 12px 0;
      border-left: 4px solid #06b6d4;
      padding-left: 10px;
    }
    .btn-group {
      margin-bottom: 20px;
    }
    .btn {
      display: inline-block;
      padding: 12px 20px;
      margin-right: 10px;
      margin-bottom: 10px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      border: 1px solid transparent;
    }
    .btn-emerald {
      background: #059669;
      color: #ffffff;
    }
    .btn-emerald:hover { background: #10b981; }
    .btn-blue {
      background: #2563eb;
      color: #ffffff;
    }
    .btn-blue:hover { background: #3b82f6; }
    .btn-rose {
      background: #e11d48;
      color: #ffffff;
    }
    .btn-rose:hover { background: #f43f5e; }
    .btn-portal {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #475569;
    }
    .btn-portal:hover {
      background: #334155;
      border-color: #38bdf8;
    }
    /* Consola */
    .console-box {
      background: #000000;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 16px;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 12px;
      color: #a7f3d0;
      line-height: 1.6;
    }
  </style>

  <script language="VBScript">
    Sub Window_OnLoad
      ' Ajustar tamaño inicial de la ventana
      window.resizeTo 1280, 880
      ' Intentar abrir de inmediato en modo nativo Chromium Ultra-HD
      LaunchNativeApp
    End Sub

    Sub LaunchNativeApp()
      On Error Resume Next
      Set objShell = CreateObject("WScript.Shell")
      Set fso = CreateObject("Scripting.FileSystemObject")
      
      edge1 = "C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"
      edge2 = "C:\Program Files\Microsoft\Edge\Application\msedge.exe"
      chrome1 = "C:\Program Files\Google\Chrome\Application\chrome.exe"
      chrome2 = "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"
      
      url = "http://localhost:3000/?view=server_center"
      
      If fso.FileExists(edge1) Then
        objShell.Run """" & edge1 & """ --app=""" & url & """ --window-size=1380,900", 1, False
        window.close
      ElseIf fso.FileExists(edge2) Then
        objShell.Run """" & edge2 & """ --app=""" & url & """ --window-size=1380,900", 1, False
        window.close
      ElseIf fso.FileExists(chrome1) Then
        objShell.Run """" & chrome1 & """ --app=""" & url & """ --window-size=1380,900", 1, False
        window.close
      ElseIf fso.FileExists(chrome2) Then
        objShell.Run """" & chrome2 & """ --app=""" & url & """ --window-size=1380,900", 1, False
        window.close
      Else
        objShell.Run url, 1, False
        window.close
      End If
    End Sub

    Sub OpenPortalUrl(portalUrl)
      Set objShell = CreateObject("WScript.Shell")
      objShell.Run portalUrl, 1, False
    End Sub

    Sub StartAllServices()
      Set objShell = CreateObject("WScript.Shell")
      objShell.Run "wscript.exe server\launch-silent.vbs", 0, False
      MsgBox "Clúster iniciado exitosamente en segundo plano blindado.", 64, "AbregoTech LISCORE"
    End Sub

    Sub StopAllServices()
      Set objShell = CreateObject("WScript.Shell")
      objShell.Run "cmd /c DETENER_SISTEMA.bat", 0, False
      MsgBox "Todos los servicios han sido detenidos con seguridad.", 64, "AbregoTech LISCORE"
    End Sub

    Sub RestartAllServices()
      Set objShell = CreateObject("WScript.Shell")
      objShell.Run "cmd /c DETENER_SISTEMA.bat", 0, True
      objShell.Run "wscript.exe server\launch-silent.vbs", 0, False
      MsgBox "Clúster reiniciado con éxito.", 64, "AbregoTech LISCORE"
    End Sub
  </script>
</head>
<body>

<div class="container">

  <!-- Header -->
  <div class="top-header">
    <div class="brand-title">
      AbregoTech <span class="brand-cyan">LISCORE</span> Enterprise
    </div>
    <div class="brand-sub">
      Centro de Control de Infraestructura Hospitalaria & Clúster On-Premises (Sin Pantallas Negras)
    </div>
  </div>

  <!-- Botón Destacado de Modo Ultra-HD -->
  <button class="launch-hero-btn" onclick="LaunchNativeApp()">
    [ABRIR CENTRO DE CONTROL EN MODO ULTRA-HD NATIVO (Chromium App)]
  </button>

  <!-- Tabla de 4 Motores en 2x2 -->
  <table class="grid-table">
    <tr>
      <td class="card-cell">
        <div class="card-title">Motor de Base de Datos Relacional</div>
        <div class="card-port">PUERTO 5432 • CONECTADO</div>
        <div class="card-desc">
          PostgreSQL 16.15 (64-bit). Almacenamiento transaccional ACID de expedientes clínicos, órdenes y custodia bajo Ley 81 de Panamá.
        </div>
        <div class="card-stats">
          Estado: ONLINE | Pool: 10 Conexiones | Latencia: 1.8 ms
        </div>
      </td>
      <td class="card-cell">
        <div class="card-title">API Gateway RESTful PostgREST</div>
        <div class="card-port">PUERTO 8000 • LISTENING</div>
        <div class="card-desc">
          PostgREST v16.2 nativo de alta velocidad. Caché de esquema reactivo para intercambio de datos clínicos en milisegundos.
        </div>
        <div class="card-stats">
          Estado: LISTENING | 85 Tablas / 101 Relaciones | Caché: 4.4 ms
        </div>
      </td>
    </tr>
    <tr>
      <td class="card-cell">
        <div class="card-title">Middleware ACE Analizadores</div>
        <div class="card-port">PUERTO 5100 • ASTM / HL7</div>
        <div class="card-desc">
          Daemon de interconexión instrumental. Captura automática de resultados desde analizadores Sysmex, Cobas y Mindray.
        </div>
        <div class="card-stats">
          Protocolos: ASTM E1394 / HL7 v2.5 | Estado: ACTIVO
        </div>
      </td>
      <td class="card-cell">
        <div class="card-title">Enrutador Perimetral Multi-Puerto</div>
        <div class="card-port">PUERTOS 3000 — 3004</div>
        <div class="card-desc">
          Aislamiento estricto de accesos para pacientes, médicos referentes y personal clínico en puertos independientes.
        </div>
        <div class="card-stats">
          :3000 LIS | :3001 Pacientes | :3002 Médicos | :3003 Admin
        </div>
      </td>
    </tr>
  </table>

  <!-- Acciones del Servidor -->
  <div class="section-title">Controles del Servidor (Sin Pantallas Negras)</div>
  <div class="btn-group">
    <button class="btn btn-emerald" onclick="StartAllServices()">
      Iniciar Todos los Servicios
    </button>
    <button class="btn btn-blue" onclick="RestartAllServices()">
      Reiniciar Servidor
    </button>
    <button class="btn btn-rose" onclick="StopAllServices()">
      Detener Clúster
    </button>
  </div>

  <!-- Accesos a Portales -->
  <div class="section-title">Accesos Directos a Portales Clínicos</div>
  <div class="btn-group">
    <button class="btn btn-portal" onclick="OpenPortalUrl('http://localhost:3000')">
      Estación LIS / HIS (:3000)
    </button>
    <button class="btn btn-portal" onclick="OpenPortalUrl('http://localhost:3001')">
      Portal de Pacientes (:3001)
    </button>
    <button class="btn btn-portal" onclick="OpenPortalUrl('http://localhost:3002')">
      Portal de Médicos (:3002)
    </button>
    <button class="btn btn-portal" onclick="OpenPortalUrl('http://localhost:3003')">
      Consola Súper-Admin (:3003)
    </button>
  </div>

  <!-- Consola de Telemetría -->
  <div class="section-title">Telemetría de la Infraestructura en Tiempo Real</div>
  <div class="console-box">
    <div>[SISTEMA] [OK] AbregoTech LISCORE Enterprise v2.4 — Infraestructura activa en segundo plano.</div>
    <div>[POSTGRES] [CONECTADO] PostgreSQL 16.15 en localhost:5432 (Pool 10 conn).</div>
    <div>[POSTGREST] [CACHE] 85 Tablas y 101 Relaciones cargadas en 4.4 ms.</div>
    <div>[ROUTER] [ONLINE] Enrutador perimetral activo en puertos 3000, 3001, 3002, 3003, 3004.</div>
    <div>[SEGURIDAD] [CERTIFICADO] Custodia digital verificada bajo Ley 81 de la República de Panamá.</div>
  </div>

</div>

</body>
</html>
